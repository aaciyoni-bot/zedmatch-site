rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Admins are set via a custom claim: admin === true on the auth token.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    // Two users are matched if a matches/{a_b} doc exists listing both uids.
    function matchId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areMatched(other) {
      return exists(/databases/$(database)/documents/matches/$(matchId(uid(), other)));
    }

    // ---- profiles ----
    // Any signed-in user can read profiles (discovery). A user can only
    // create/edit their OWN profile. Sensitive fields are never stored here
    // (no exact GPS, no phone shown to others). verified/premium are set by
    // the server/admin only, so clients can't self-verify or self-upgrade.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && userId == uid()
                    && request.resource.data.age >= 18
                    && request.resource.data.verified == false
                    && request.resource.data.premium == false;
      allow update: if signedIn() && userId == uid()
                    && request.resource.data.age >= 18
                    // clients cannot flip these — only admin/server may:
                    && request.resource.data.verified == resource.data.verified
                    && request.resource.data.premium == resource.data.premium;
      allow delete: if isAdmin();
    }

    // ---- swipes (likes/passes) ----
    // A user writes only their own swipes; nobody else can read them.
    match /swipes/{swipeId} {
      allow create: if signedIn() && request.resource.data.by == uid();
      allow read, update, delete: if false; // server/functions handle match detection
    }

    // ---- matches ----
    // Readable only by the two users in the match (or admin). Created by the
    // server (Cloud Function) when a mutual like is detected.
    match /matches/{matchId} {
      allow read: if signedIn() && (uid() in resource.data.users) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---- messages ----
    // Only exchangeable between matched users. Sender must be the author,
    // and the two of them must have an existing match.
    match /messages/{msgId} {
      allow read: if signedIn() && (uid() in resource.data.participants);
      allow create: if signedIn()
                    && request.resource.data.from == uid()
                    && uid() in request.resource.data.participants
                    && areMatched(request.resource.data.to);
      allow update, delete: if false;
    }

    // ---- reports ----
    // Anyone signed-in can file a report (write-only). Only admins can read
    // and resolve them.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.by == uid();
      allow read, update, delete: if isAdmin();
    }

    // ---- verifications (selfie review) ----
    // A user submits their own; only admins can read and approve/reject.
    match /verifications/{verifId} {
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow read, update, delete: if isAdmin();
    }
  }
}
